# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when encountering an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains default template is maintained in their global .gitignore that can be
#  merged into this file. For a more nuclear option, it is possible to
#  uncomment the following line.
#.idea/

web/dist/
web/node_modules/
web/tsconfig.tsbuildinfo
.codex-ui/
